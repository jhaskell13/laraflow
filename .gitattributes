# Normalize line endings: store LF in the repository, check out LF everywhere.
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

# Exclude development files from Composer dist archives
/.github         export-ignore
/tests           export-ignore
/workbench       export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/phpunit.xml     export-ignore
/testbench.yaml  export-ignore
/phpstan.neon    export-ignore
/pint.json       export-ignore
# Decided in Milestone 6 step 10: the dist archive is what an application
# vendors. Planning documents and development scaffolding stay out of it;
# README, CHANGELOG, LICENSE, SECURITY, CONTRIBUTING, and docs/ ship,
# because the README links into docs/ and an offline copy should resolve.
/.env.example    export-ignore
/composer.lock   export-ignore
# Project governance, not package documentation: nothing loads either
# at runtime. README and docs/ link to ROADMAP.md, and those links point
# at the repository copy when read offline from vendor/ — accepted, as
# the roadmap describes the project's plans, not the installed version.
/ROADMAP.md          export-ignore
/CODE_OF_CONDUCT.md  export-ignore
# The optional packages are packages of their own, split to their own
# repositories to publish (docs/decisions/0011): an application that
# requires the core must not vendor a package it did not ask for.
/packages            export-ignore
# The documentation site's toolchain: docs/ ships as Markdown, its build
# configuration does not.
/docs/.vitepress     export-ignore
/docs/package.json   export-ignore
/docs/package-lock.json export-ignore
