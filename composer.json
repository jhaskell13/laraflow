{
    "name": "laraflow/laraflow",
    "description": "Laravel-native framework for building integrations and durable, recoverable workflows.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "workflow",
        "integration",
        "automation",
        "durable-execution",
        "orchestration"
    ],
    "authors": [
        {
            "name": "James Haskell"
        }
    ],
    "support": {
        "issues": "https://github.com/jhaskell13/laraflow/issues",
        "source": "https://github.com/jhaskell13/laraflow",
        "security": "https://github.com/jhaskell13/laraflow/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Laraflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraflow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraflow\\Core\\LaraflowServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
