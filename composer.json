{
    "name": "laraflow/laraflow",
    "description": "Laravel-native integration and automation framework",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.12"
    },
    "autoload": {
        "psr-4": {
            "Laraflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraflow\\Core\\LaraflowServiceProvider"
            ]
        }
    }
}
