{
    "name": "laraflow/opentelemetry",
    "description": "OpenTelemetry traces for Laraflow workflows: a span for every run, step attempt, and connector call, joined across queue workers and days, as docs/tracing.md defines.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laraflow",
        "workflow",
        "opentelemetry",
        "otel",
        "tracing",
        "observability"
    ],
    "homepage": "https://github.com/jhaskell13/laraflow",
    "support": {
        "issues": "https://github.com/jhaskell13/laraflow/issues",
        "source": "https://github.com/jhaskell13/laraflow"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "laraflow/laraflow": "^0.7",
        "open-telemetry/api": "^1.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "open-telemetry/sdk": "^1.4",
        "orchestra/testbench": "^10.12|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "open-telemetry/sdk": "Required to record anything: configure a tracer provider and exporter, as for any OpenTelemetry instrumentation.",
        "open-telemetry/exporter-otlp": "Export to any OTLP endpoint \u2014 a collector, Tempo, Honeycomb, Datadog."
    },
    "autoload": {
        "psr-4": {
            "Laraflow\\OpenTelemetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraflow\\OpenTelemetry\\Tests\\": "tests/",
            "Laraflow\\Tests\\": "../../tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraflow\\OpenTelemetry\\OpenTelemetryServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "laraflow/laraflow": "0.7.x-dev"
                }
            }
        }
    ],
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
